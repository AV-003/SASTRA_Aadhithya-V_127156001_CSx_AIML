# Default: no external LLM is used. The app will use an evidence-based fallback.
AUTOSAR_HLD_LLM_PROVIDER=none

# Local Ollama option:
# AUTOSAR_HLD_LLM_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# External OpenAI option. Use only when you explicitly consent to sending
# retrieved document excerpts to the API.
# AUTOSAR_HLD_LLM_PROVIDER=openai
# AUTOSAR_ALLOW_EXTERNAL_LLM=true
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

